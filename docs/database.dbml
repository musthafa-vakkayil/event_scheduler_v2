Project event_scheduler {
  database_type: 'PostgreSQL'
  Note: '''
    # Event Scheduler Database
    **markdown content here**
  '''
}

Table users as U {
  username varchar [pk]
  full_name varchar [not null]
  hashed_password varchar [not null]
  password_chnaged_at timestampz [not null, default: `0001:01:01 00:00:00Z`]
  created_at timestampz [not null, default: `now()`]
  updated_at timestampz [not null, default: `now()`]
}

TABLE event as E{
  id bigserial [pk]
  name varchar [not null]
  type enum('API')
  api_end_point varchar [not null]
  api_method varchar [not null]
  api_request_body JSON
  created_by varchar [ref: > U.username]
  created_at timestampz [not null, default: `now()`]
  executed_at timestampz [default: null]
}

TABLE logs as L{
  id bigserial [pk]
  event_id bigint [ref: > event.id]
  executed_on timestampz [not null]
  status enum('SUCCESS', 'FAILED')
  is_archived bool [default: false]
}

TABLE sessions as S{
  id uuid [pk]
  username varchar [ref:> U.username, not null]
  refresh_token varchar [not null]
  user_agent varchar [not null]
  client_ip varchar [not null]
  is_blocked bool [default: false]
  expires_at timestampz [not null]
  created_at timestampz [not null, default: `now()`]
}